# Dockerfile to cross-compile Windows .exe using Wine + Python 3.11
FROM --platform=linux/amd64 tobix/pywine:3.11

WORKDIR /src

# Update packages inside Wine: PyInstaller, Pillow, pywebview, and PyQt6 + PyQt6-WebEngine for true standalone desktop window
RUN wine python -m pip install --no-warn-script-location --upgrade pip && \
    wine python -m pip install --no-warn-script-location pyinstaller pillow pywebview PyQt6 PyQt6-WebEngine

# Default command compiles using the LGCCaseRegister.spec file
ENTRYPOINT ["wine", "pyinstaller"]
CMD ["--clean", "--noconfirm", "LGCCaseRegister.spec"]
